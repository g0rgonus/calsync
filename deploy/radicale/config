# Radicale 3.x. Verify against the docs for the version you pull —
# docs/deployment/radicale.md §7 notes that 2.x and 3.x differ enough that a
# copied snippet will not work.

[server]
# Container-internal. Public exposure is the compose port binding's job, and it
# is deliberately loopback-only.
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /config/users
# bcrypt, not plaintext, even on a private network (deployment doc §3).
htpasswd_encryption = bcrypt

[rights]
type = from_file
file = /config/rights

[storage]
# multifilesystem, NOT a database backend. One .ics per event satisfies R4/R5
# by construction: a server that normalizes properties silently destroys
# X-CALSYNC-* provenance and the X-APPLE-STRUCTURED-LOCATION pin.
type = multifilesystem
filesystem_folder = /data/collections

# Free version history of every schedule change. Note the hook fires per storage
# operation, so a first-run backfill produces a commit per event (§4).
hook = git add -A && (git diff --cached --quiet || git commit -m "calsync: %(user)s")

[logging]
level = info
