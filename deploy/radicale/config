# Radicale 3.x. Requirements and acceptance checks: docs/deployment/radicale.md.

[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /config/users
htpasswd_encryption = bcrypt

[rights]
type = from_file
file = /config/rights

[storage]
# File-backed, not a database backend: one .ics per event, so unknown X-
# properties survive a round trip (R4/R5).
type = multifilesystem
filesystem_folder = /data/collections

[logging]
level = info
