# `calsync init-deploy` writes a .env from this file with the first three filled
# in. This copy is the reference — every key, and what it does in
# docs/deployment/compose.md.
#
# The first three are required; the stack refuses to start without them. Any
# random strings will do:  openssl rand -base64 24

CALSYNC_SECRET_RADICALE_PASSWORD=
CALSYNC_SECRET_RADICALE_READER_PASSWORD=
CALSYNC_SECRET_API_TOKEN=

# --- everything below is optional ---

#CALSYNC_SETTING_RADICALE_URL=http://radicale:5232
#CALSYNC_API_REPLICAS=0

# Subscribe a phone to a calendar with no password: anything that can reach this
# stack can then read every event, so it is worth the same thought as the
# console, which has no login either. Writing still needs the writer's
# credential. docs/deployment/radicale.md §3.
#
# Read by docker-compose.yml, not by calsync — needs the 0.6.0 compose file.
#CALSYNC_RADICALE_ANONYMOUS_READ=1

#CALSYNC_SETTING_MATRIX_HOMESERVER=https://matrix.example.org
#CALSYNC_SETTING_MATRIX_USER_ID=@calsync:example.org
#CALSYNC_SETTING_MATRIX_ROOM_ID=!abcdef:example.org
#CALSYNC_SECRET_MATRIX_ACCESS_TOKEN=
#CALSYNC_SETTING_DIGEST_SEND_AT=07:30

#CALSYNC_SECRET_PUSHOVER_TOKEN=
#CALSYNC_SECRET_PUSHOVER_USER=

#CALSYNC_SETTING_DEFAULT_TZ=America/Toronto
#CALSYNC_SETTING_TITLE_TEMPLATE={kids} {emoji} {detail}
#CALSYNC_SETTING_COLLECTION_TEMPLATE={type}

#CALSYNC_TAG=release
