# Everything a calsync deployment can decide before it starts. Copy to `.env`
# in the same directory as docker-compose.yml and fill in what you want.
#
#   cp .env.example .env
#
# Every line here is optional. Unset is the normal case: an empty value means
# "not configured" and is ignored rather than seeded, so it never replaces a
# working default. `docker compose up -d` with no `.env` at all is a supported
# first run — the calendar passwords get generated.
#
# Two prefixes, and no third mechanism:
#
#   CALSYNC_SETTING_<KEY>  seeds a row in the settings table when the database
#                          is first created. Any key in `db.DEFAULT_SETTINGS`
#                          works, not only the ones listed here. Seed-only: an
#                          edit made later in the console wins, because a
#                          variable that reasserted itself on every restart
#                          would silently undo it.
#   CALSYNC_SECRET_<REF>   resolves a credential. Checked before the secrets
#                          file, every time, so anything set here needs no file
#                          entry — and can be removed again by unsetting it.
#
# Feed tokens are deliberately not here. They arrive by pasting a team's URL
# during onboarding, one per team, and nobody knows them before startup.


# --- the calendar server ----------------------------------------------------

# calsync's own account. Leave unset and the bootstrap service generates one,
# hashes it into Radicale's users file and stores it. Set it and that value is
# hashed instead — and is never copied into the secrets file, because somebody
# who kept a credential out of a file did not ask for it to be written to one.
# Changing it re-derives the users file on the next start.
#CALSYNC_SECRET_RADICALE_PASSWORD=

# The read-only account: the one typed into a phone's CalDAV settings, and into
# Radicale's own web UI to look at what calsync has written. Read-only on
# purpose — nothing but calsync writes to that server, and a credential sitting
# on a family's phones should not be able to delete a collection. Generated and
# printed once if unset (`docker compose logs bootstrap`), and kept in the
# secret store as `radicale_reader_password`.
#CALSYNC_SECRET_RADICALE_READER_PASSWORD=

# Where the calendar server is. The default is right for this compose stack;
# change it only to point calsync at a CalDAV server it does not run.
#CALSYNC_SETTING_RADICALE_URL=http://radicale:5232


# --- Matrix, for the daily digest and review notifications ------------------
# All four or none. An empty homeserver is what "off" looks like. Outbound
# only: calsync posts to the room and reads nothing back (docs/MATRIX.md §7).

#CALSYNC_SETTING_MATRIX_HOMESERVER=https://matrix.example.org
#CALSYNC_SETTING_MATRIX_USER_ID=@calsync:example.org
#CALSYNC_SETTING_MATRIX_ROOM_ID=!abcdef:example.org
#CALSYNC_SECRET_MATRIX_ACCESS_TOKEN=

# When the digest goes out, HH:MM in local time. Empty means never, which is
# the default — the poller carries it, so there is no cron to forget about.
#CALSYNC_SETTING_DIGEST_SEND_AT=07:30


# --- Pushover, for the few things that need you rather than inform you -------

#CALSYNC_SECRET_PUSHOVER_TOKEN=
#CALSYNC_SECRET_PUSHOVER_USER=


# --- the read API (docker compose --profile api up -d api) -------------------
# It refuses to start without this, on purpose: a read API for a family's
# schedule that came up unusable is one nobody notices is broken.

#CALSYNC_SECRET_API_TOKEN=


# --- household conventions --------------------------------------------------
# Seeded on first run, editable in the console afterwards. The full list is
# `DEFAULT_SETTINGS` in src/calsync/db/__init__.py.

#CALSYNC_SETTING_DEFAULT_TZ=America/Toronto
#CALSYNC_SETTING_TITLE_TEMPLATE={kids} {emoji} {detail}
#CALSYNC_SETTING_COLLECTION_TEMPLATE={type}


# --- the image tag compose runs ---------------------------------------------
# Defaults to `release`, the newest tagged version, which is what a deployment
# wants. The others exist for people working on calsync rather than running it:
#
#   release   newest tagged version   (the default; what the README points at)
#   latest    main                    (merged and tested, not yet a version)
#   dev       a feature branch        (whatever is being worked on)
#   v0.2      newest 0.2.x            (pin a minor line)
#   v0.2.0    exactly that release    (pin outright)
#   sha-1a2b3c4  one build            (bisecting, or reproducing a report)

#CALSYNC_TAG=release
